    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^20",
    "@types/papaparse": "5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
