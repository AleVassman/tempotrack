# Copy to .env.local and fill in the values of YOUR Firebase project
# (Firebase console > Project settings > General > Your apps > Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Web Push certificate (Project settings > Cloud Messaging > Web Push certificates).
# Leave empty to disable push notifications.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Demo mode: shows one-click "sign in as" buttons on the login page.
# The same password is used by `pnpm seed` for every demo account.
# This value is PUBLIC (it ships in the client bundle): use it only for demo accounts.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PASSWORD=change-me-demo-password

# Set to true to use the local Firebase Emulator Suite instead of a real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
